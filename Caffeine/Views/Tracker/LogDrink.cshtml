@model Caffeine.ViewModels.LogDrinkFormViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
ViewData["Title"] = Localizer["Új Ital Rögzítése"];
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        @Localizer["Vissza a Dashboardra"]
    </a>
</div>

<div class="glass rounded-3xl p-6 shadow-2xl relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-cyan-500/20 blur-[50px] rounded-full"></div>
    <h2 class="text-2xl font-black text-white mb-6 relative z-10">@Localizer["Mit ittál? ☕⚡"]</h2>

    <form asp-action="LogDrink" method="post" class="relative z-10">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 mb-4 text-sm bg-rose-500/10 p-3 rounded-lg border border-rose-500/20"></div>

        <!-- KAPCSOLÓ: Egyedi ital? -->
        <div class="mb-6 flex items-center">
            <input asp-for="IsCustomDrink" type="checkbox" id="IsCustomDrink" onchange="toggleCustomDrink()" class="w-5 h-5 text-cyan-500 bg-slate-800 border-slate-600 rounded focus:ring-cyan-500 focus:ring-2 cursor-pointer" />
            <label asp-for="IsCustomDrink" for="IsCustomDrink" class="ml-3 text-sm font-medium text-slate-300 cursor-pointer select-none">
                @Localizer["Egyedi italt adok meg (Nincs a listában)"]
            </label>
        </div>

        <!-- NORMÁL LISTA -->
        <div id="dropdown-section" class="mb-5 transition-all">
            <label asp-for="SelectedBeverageId" class="block text-sm font-medium text-slate-300 mb-2">@Localizer["Választott Ital"]</label>
            <select asp-for="SelectedBeverageId" asp-items="Model.BeverageOptions" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 transition-colors appearance-none cursor-pointer">
                <option value="">@Localizer["-- Válassz a listából --"]</option>
            </select>
            <span asp-validation-for="SelectedBeverageId" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <!-- EGYEDI ITAL SZEKCIÓ (Alapból rejtve) -->
        <div id="custom-section" class="hidden space-y-5 mb-5 bg-slate-800/40 p-4 rounded-xl border border-slate-700">
            <div>
                <label asp-for="CustomBeverageName" class="block text-sm font-medium text-cyan-400 mb-2">@Localizer["Ital neve"]</label>
                <input asp-for="CustomBeverageName" type="text" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500" placeholder="@Localizer["pl. Pistikém pre-workoutja"]" />
            </div>
            <div>
                <label asp-for="CustomCaffeinePer100Ml" class="block text-sm font-medium text-cyan-400 mb-2">@Localizer["Mennyi koffein (mg) van 100 ml-ben?"]</label>
                <!-- Kicserélve a mg/100ml inputra -->
                <input asp-for="CustomCaffeinePer100Ml" type="number" step="0.1" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500" placeholder="@Localizer["pl. 32"]" />
            </div>
        </div>

        <!-- MENNYISÉG -->
        <div class="mb-5">
            <label asp-for="AmountMl" class="block text-sm font-medium text-slate-300 mb-2">@Localizer["Mennyiség (ml)"]</label>
            <div class="relative">
                <input asp-for="AmountMl" type="number" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl pl-4 pr-12 py-3 text-white focus:outline-none focus:border-cyan-500 transition-colors" placeholder="@Localizer["pl. 250"]" />
                <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400 font-medium">ml</div>
            </div>
            <span asp-validation-for="AmountMl" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <!-- IDŐPONT -->
        <div class="mb-8">
            <label asp-for="ConsumedAt" class="block text-sm font-medium text-slate-300 mb-2">@Localizer["Mikor?"]</label>
            <input asp-for="ConsumedAt" type="datetime-local" value="@Model.ConsumedAt.ToString("yyyy-MM-ddTHH:mm")" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 [color-scheme:dark]" />
            <span asp-validation-for="ConsumedAt" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <!-- MENTÉS GOMB -->
        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold text-lg py-4 rounded-xl shadow-[0_0_15px_rgba(34,211,238,0.4)] transition-all active:scale-95 flex justify-center items-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            @Localizer["Naplóhoz adom"]
        </button>
    </form>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script>
    // Ez a JS váltogatja a nézetet a Custom Drink checkbox alapján
    function toggleCustomDrink() {
        const isCustom = document.getElementById('IsCustomDrink').checked;
        const dropdown = document.getElementById('dropdown-section');
        const custom = document.getElementById('custom-section');

        if (isCustom) {
            dropdown.style.display = 'none';
            custom.style.display = 'block';
        } else {
            dropdown.style.display = 'block';
            custom.style.display = 'none';
        }
    }

    // Oldal betöltéskor fusson le (pl. ha hiba miatt újra betölti az űrlapot)
    document.addEventListener("DOMContentLoaded", function() {
        toggleCustomDrink();
    });
</script>
}