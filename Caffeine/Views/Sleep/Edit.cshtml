@model Caffeine.ViewModels.SleepForm
@inject Caffeine.Services.TrackerClock Clock
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T

@{
    ViewData["Title"] = T["SleepCheckIn"];
}

<div class="flex items-center justify-between gap-2"><h1 class="text-2xl font-bold mb-5">
    @T["SleepCheckIn"]
</h1><partial name="_InfoButton" model='@("SleepSnapshotNote")' /></div>

<p class="text-sm text-slate-400 mb-5">
    @T["SleepDateNote"]
</p>

<form asp-action="Edit"
      method="post"
      class="glass rounded-3xl p-5 feature-form"
      data-single-submit>

    <div asp-validation-summary="All"
         class="text-rose-400"
         role="alert"></div>

    <input asp-for="Id"
           type="hidden" />

    <label asp-for="ActualBedtime">
        @T["ActualBedtime"]
    </label>

    <input asp-for="ActualBedtime"
           type="datetime-local"
           asp-format="{0:yyyy-MM-ddTHH:mm}"
           class="field"
           required />

    <label asp-for="WakeTime">
        @T["WakeTime"]
    </label>

    <input asp-for="WakeTime"
           type="datetime-local"
           asp-format="{0:yyyy-MM-ddTHH:mm}"
           class="field"
           required />

    <label asp-for="SleepRating">
        @T["SleepRating"]
    </label>

    <select asp-for="SleepRating"
            class="field">
        @for (var n = 1; n <= 5; n++)
        {
            <option value="@n">
                @n — @T["Rating" + n]
            </option>
        }
    </select>

    @foreach(var field in new[]{("BedtimeOffsetMinutes",Model.ActualBedtime,Model.BedtimeOffsetMinutes),("WakeOffsetMinutes",Model.WakeTime,Model.WakeOffsetMinutes)}) {
        @if(field.Item2.HasValue && Clock.Zone.IsAmbiguousTime(DateTime.SpecifyKind(field.Item2.Value,DateTimeKind.Unspecified))) {
            <label for="@field.Item1">@T["AmbiguousClock"] (@field.Item2.Value.ToString("g"))</label>
            <select name="@field.Item1" id="@field.Item1" class="field" required><option value="">—</option>
                @foreach(var offset in Clock.Zone.GetAmbiguousTimeOffsets(DateTime.SpecifyKind(field.Item2.Value,DateTimeKind.Unspecified))) {
                    <option value="@((int)offset.TotalMinutes)" selected="@(field.Item3==(int)offset.TotalMinutes)">UTC @offset</option>
                }
            </select>
        }
    }
    <details class="my-4">
        <summary>@T["OptionalDetails"]</summary>

        <label asp-for="PlannedBedtime">
            @T["PlannedBedtime"]
        </label>

        <input asp-for="PlannedBedtime"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               class="field" />

        <label asp-for="FallingAsleep">
            @T["FallingAsleep"]
        </label>

        <select asp-for="FallingAsleep"
                class="field">

            <option value="">—</option>

            @for (var n = 1; n <= 5; n++)
            {
                <option value="@n">
                    @n — @T["Difficulty" + n]
                </option>
            }
        </select>

        <label asp-for="Awakenings">
            @T["Awakenings"]
        </label>

        <input asp-for="Awakenings"
               type="number"
               min="0"
               max="50"
               class="field" />

        <label asp-for="Notes">
            @T["Notes"]
        </label>

        <textarea asp-for="Notes"
                  maxlength="2000"
                  rows="3"
                  class="field"></textarea>
    </details>



    <button type="submit"
            class="nav-tab">
        @T["Save"]
    </button>

    <a asp-action="Index"
       class="nav-tab">
        @T["Cancel"]
    </a>
</form>
