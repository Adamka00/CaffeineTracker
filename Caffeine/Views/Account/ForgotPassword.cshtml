@model Caffeine.ViewModels.ForgotPasswordForm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T

@{
    Layout = "_RecoveryLayout";
    ViewData["Title"] = T["ForgotPassword"];
}

<h1 class="text-2xl font-bold mb-5">
    @T["ForgotPassword"]
</h1>

@if (Model.Submitted)
{
    <p class="glass rounded-3xl p-5"
       role="status">
        @T["ResetGenericResponse"]
    </p>
}
else
{
    <form method="post"
          class="glass rounded-3xl p-5 feature-form"
          data-single-submit>

        <div asp-validation-summary="All"
             class="text-rose-400">
        </div>

        <label asp-for="Email">
            @T["Email"]
        </label>

        <input asp-for="Email"
               type="email"
               autocomplete="email"
               maxlength="254"
               class="field"
               required />

        <button type="submit"
                class="nav-tab mt-4">
            @T["SendResetLink"]
        </button>

    </form>
}

<a asp-action="Login"
   class="text-cyan-400 inline-block mt-4">
    @T["BackToLogin"]
</a>