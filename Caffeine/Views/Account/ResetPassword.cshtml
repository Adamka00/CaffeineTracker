@model Caffeine.ViewModels.ResetPasswordForm
    @inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T

    @{
    Layout = "_RecoveryLayout";
    ViewData["Title"] = T["ResetPassword"];
}

<h1 class="text-2xl font-bold mb-5">
    @T["ResetPassword"]
    </h1>

    @if (Model.Completed)
{
    <p role="status">
            @T["PasswordResetComplete"]
            </p>

        <a asp-action="Login"
    class="nav-tab inline-block mt-4">
        @T["BackToLogin"]
        </a>
}
else if (Model.InvalidToken)
{
    <p role="alert">
            @T["InvalidResetToken"]
            </p>

        <a asp-action="ForgotPassword"
    class="text-cyan-400">
        @T["SendResetLink"]
        </a>
}
else
{
    <form asp-action="ResetPassword"
    method="post"
    class="glass rounded-3xl p-5 feature-form"
    data-single-submit>

        <div asp-validation-summary="All"
    class="text-rose-400">
        </div>

        <input asp-for="Token"
    type="hidden" />

        <label asp-for="Password">
        @T["NewPassword"]
        </label>

        <input asp-for="Password"
    type="password"
    autocomplete="new-password"
    minlength="10"
    maxlength="128"
    class="field"
    required />

        <label asp-for="ConfirmPassword">
        @T["ConfirmPassword"]
        </label>

        <input asp-for="ConfirmPassword"
    type="password"
    autocomplete="new-password"
    minlength="10"
    maxlength="128"
    class="field"
    required />

        <p class="text-xs text-slate-400 my-4">
        @T["PasswordLengthNote"]
        </p>

        <button type="submit"
    class="nav-tab">
        @T["ResetPassword"]
        </button>

        </form>
}