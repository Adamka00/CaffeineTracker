@model Caffeine.ViewModels.LoginViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Bejelentkezés"];
}

<div class="mb-6">
    <a asp-controller="Tracker" asp-action="Index" class="inline-flex items-center text-cyan-400 hover:text-cyan-300 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        @Localizer["Vissza a Dashboardra"]
    </a>
</div>

<div class="glass rounded-3xl p-6 shadow-2xl relative overflow-hidden max-w-sm mx-auto">
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-cyan-500/20 blur-[50px] rounded-full"></div>
    <h2 class="text-2xl font-black text-white mb-6 relative z-10">@Localizer["Bejelentkezés"]</h2>

    <form asp-action="Login" method="post" class="relative z-10">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 text-sm mb-4 bg-rose-500/10 p-3 rounded-lg border border-rose-500/20"></div>

        <div class="mb-5">
            <label asp-for="Email" class="block text-sm font-medium text-slate-300 mb-2">@Localizer["Email"]</label>
            <input asp-for="Email" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:border-cyan-500 outline-none focus:ring-1 focus:ring-cyan-500" />
            <span asp-validation-for="Email" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <div class="mb-8">
            <label asp-for="Password" class="block text-sm font-medium text-slate-300 mb-2">@Localizer["Jelszó"]</label>
            <input asp-for="Password" type="password" class="w-full bg-slate-800/70 border border-slate-600 rounded-xl px-4 py-3 text-white focus:border-cyan-500 outline-none focus:ring-1 focus:ring-cyan-500" />
            <span asp-validation-for="Password" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold text-lg py-3 rounded-xl transition-colors shadow-[0_0_15px_rgba(34,211,238,0.4)]">@Localizer["Bejelentkezés"]</button>
    </form>
</div>