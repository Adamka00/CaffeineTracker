@model Caffeine.ViewModels.NotificationForm

@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T

@{
    ViewData["Title"] = T["Notifications"];
}

<h1 class="text-2xl font-bold mb-4">
    @T["Notifications"]
</h1>

<p class="text-sm text-slate-400 mb-4">
    @T["NotificationNote"]
</p>


@if (TempData["NotificationSaved"] != null)
{
    <p role="status"
       class="mb-4">
        @T["PreferencesSaved"]
    </p>
}


<form method="post"
      class="glass rounded-3xl p-5 feature-form">

    <div asp-validation-summary="All"
         class="text-rose-400">
    </div>


    <label>
        <input asp-for="StreakReminder" />
        @T["StreakReminder"]
    </label>

    <label asp-for="StreakTime">
        @T["StreakReminderTime"]
    </label>

    <input asp-for="StreakTime"
           type="time"
           class="field"
           required />


    <label>
        <input asp-for="SleepCheckIn" />
        @T["MorningReminder"]
    </label>

    <label asp-for="MorningTime">
        @T["MorningReminderTime"]
    </label>

    <input asp-for="MorningTime"
           type="time"
           class="field"
           required />


    <label>
        <input asp-for="CutoffReminder" />
        @T["CutoffReminder"]
    </label>

    <label asp-for="CutoffDoseMg">
        @T["CutoffDose"] (mg)
    </label>

    <input asp-for="CutoffDoseMg"
           type="number"
           min="1"
           max="2000"
           class="field" />


    <label>
        <input asp-for="ThresholdReached" />
        @T["ThresholdReminder"]
    </label>


    <p class="text-xs text-slate-400 my-4">
        @T["NotificationTimeNote"]
    </p>


    <a asp-controller="Planning"
       asp-action="Settings"
       class="text-cyan-400">
        @T["PlanningSettings"]
    </a>


    <button type="submit"
            class="nav-tab mt-4 block">
        @T["Save"]
    </button>

</form>


<section class="glass rounded-3xl p-5 mt-5"
         id="push-controls"
         data-key="@Model.PublicKey"
         data-ok="@T["PushEnabled"]"
         data-off="@T["PushDisabled"]"
         data-error="@T["PushFailed"]"
         data-unsupported="@T["PushUnsupported"]">

    <h2 class="font-bold mb-3">
        @T["ThisDevice"]
    </h2>


    <p class="text-xs text-slate-400 mb-4">
        @T["IosPushNote"]
    </p>


    @if (Model.PushConfigured)
    {
        <button type="button"
                id="enable-push"
                class="nav-tab">
            @T["EnablePush"]
        </button>

        <button type="button"
                id="disable-push"
                class="nav-tab mt-2">
            @T["DisablePush"]
        </button>
    }
    else
    {
        <p>
            @T["PushNotConfigured"]
        </p>
    }


    <p id="push-status"
       role="status"
       class="text-sm mt-3">
    </p>


    <p class="text-xs text-slate-400 mt-3">
        @T["DeviceCount", Model.DeviceCount]
    </p>


    <form asp-action="UnsubscribeAll"
          method="post"
          class="mt-3"
          data-confirm="@T["DisableAllConfirm"]">

        <button type="submit"
                class="text-rose-400">
            @T["DisableAllDevices"]
        </button>

    </form>

</section>


@section Scripts
{
    <script src="~/js/push-settings.js"
            asp-append-version="true">
    </script>
}