@model Caffeine.ViewModels.PreferenceForm
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T

@{
    ViewData["Title"] = T["PlanningSettings"];
}

<div class="flex items-center justify-between gap-2"><h1 class="text-2xl font-bold mb-5">
    @T["PlanningSettings"]
</h1><partial name="_InfoButton" model='@("PersonalTargetNote")' /></div>

<form method="post"
      class="glass rounded-3xl p-5 feature-form">

    <div asp-validation-summary="All"
         class="text-rose-400">
    </div>

    <label asp-for="PlannedBedtime">
        @T["PlannedBedtime"]
    </label>

    <input asp-for="PlannedBedtime"
           type="time"
           class="field"
           required />

    <label asp-for="TargetMg">
        @T["PersonalTarget"] (mg)
    </label>

    <input asp-for="TargetMg"
           type="number"
           min="1"
           max="200"
           class="field"
           required />



    <button type="submit"
            class="nav-tab">
        @T["Save"]
    </button>

</form>
