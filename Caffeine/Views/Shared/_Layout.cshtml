@using Caffeine.Services
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T
@inject ExperienceService Experience
@inject CurrentTrackerUser TrackerUser
@inject TrackerClock Clock
@{ var state = await Experience.GetAsync(TrackerUser.GetId());
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Context.Response.Headers.CacheControl = "no-store";
}
<!DOCTYPE html>
<html lang="@culture" class="dark" data-tracker-day="@Clock.Now.ToString("yyyy-MM-dd")">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · Koffi</title>
    <link rel="icon" href="/icon-192.png" /><link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.json" /><meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" /><meta name="apple-mobile-web-app-title" content="Koffi" />
    <script src="https://cdn.tailwindcss.com"></script><script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="~/css/tracker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/koffi4.css" asp-append-version="true" />
</head>
<body class="bg-slate-900 text-slate-200 font-sans" data-client-key="@state.ClientKey">
<a class="skip-link" href="#main-content">@T["SkipToContent"]</a>
<header class="app-header">
    <a class="brand" asp-controller="Tracker" asp-action="Index"><img src="~/icon-192.png" alt="" width="36" height="36" /><span>Koffi</span><small>@ReleaseCatalog.Current.Version</small></a>
    <div class="header-actions">
        <form asp-controller="Tracker" asp-action="SetLanguage" method="post">
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <label class="sr-only" for="app-language">@T["Language"]</label>
            <select id="app-language" name="culture" class="language-select" data-language>
                @foreach (var lang in new[] { "hu", "en", "de" }) { <option value="@lang" selected="@(lang == culture)">@lang.ToUpperInvariant()</option> }
            </select><button type="submit" class="language-go">@T["Go"]</button>
        </form>
        <a asp-controller="Help" asp-action="Index" class="info-button" aria-label="@T["HelpTitle"]">?</a>
        <details class="account-menu"><summary aria-label="@T["Account"]">☰</summary><div class="account-panel glass">
            @if (User.Identity?.IsAuthenticated == true) {
                <p class="account-name">@User.Identity.Name</p>
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-tab">@T["Logout"]</button></form>
                <form asp-controller="Account" asp-action="DeleteAccount" method="post" data-confirm="@T["DeleteAccountConfirm"]"><button type="submit" class="danger-button">@T["DeleteAccount"]</button></form>
            } else {
                <a asp-controller="Account" asp-action="Login">@T["Login"]</a><a asp-controller="Account" asp-action="Register">@T["Register"]</a>
                <small>@T["GuestMode"]</small>
            }
            <a asp-controller="Planning" asp-action="Settings">@T["PlanningSettings"]</a>
            <a asp-controller="Help" asp-action="WhatsNew">@T["WhatsNew"]</a>
            <a asp-controller="Help" asp-action="Support">@T["SupportTitle"]</a>
        </div></details>
    </div>
</header>
<nav class="app-nav" aria-label="@T["Navigation"]">
    @foreach (var tab in new[] { ("Tracker", "Daily", "☕"), ("Sleep", "SleepTitle", "☾"), ("Planning", "PlanningShort", "◷"), ("Stats", "LifetimeShort", "▥") }) {
        <a asp-controller="@tab.Item1" asp-action="Index" class="@(controller == tab.Item1 ? "active" : "")" aria-current="@(controller == tab.Item1 ? "page" : null)"><span aria-hidden="true">@tab.Item3</span>@T[tab.Item2]</a>
    }
</nav>
<main id="main-content" class="app-main">
    @if (state.ShowMorning && controller is not ("Account" or "Barcode")) {
        <aside id="morning-reminder" class="glass morning-card" role="region" aria-label="@T["MorningTitle"]">
            <div><strong>@T["MorningTitle"]</strong><p>@T["MorningPrompt"]</p></div>
            <a asp-controller="Sleep" asp-action="Edit" class="primary-button">@T["SleepCheckIn"]</a>
            <button type="button" class="quiet-button" data-dismiss-morning>@T["NotNow"]</button>
        </aside>
    }
    @RenderBody()
    <footer class="app-footer"><a asp-controller="Home" asp-action="Privacy">@T["PrivacyTitle"]</a><a asp-controller="Help" asp-action="WhatsNew">@T["WhatsNew"]</a><a asp-controller="Help" asp-action="Support">@T["SupportTitle"] ☕</a></footer>
</main>
<a asp-controller="Tracker" asp-action="LogDrink" class="add-drink-fab" aria-label="@T["AddDrink"]"><span aria-hidden="true">＋</span><span class="fab-text">@T["AddDrink"]</span></a>
<partial name="_Experience" model="state" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/drink-search.js" asp-append-version="true"></script>
<script src="~/js/experience-state.js" asp-append-version="true"></script>
<script src="~/js/koffi4.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
