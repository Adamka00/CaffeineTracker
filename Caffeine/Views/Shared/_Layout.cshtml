@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="hu" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Caffeine Tracker</title>


    <link rel="icon" type="image/png" href="/icon-192.png">


    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#06b6d4">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .glass { background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
    </style>
</head>
<body class="bg-slate-900 text-slate-200 font-sans min-h-screen pb-24 selection:bg-cyan-500 selection:text-white relative">
<main class="container mx-auto p-4 max-w-md">
    @{
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCultureFeature?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "hu";
    var targetCulture = currentCulture == "hu" ? "en" : "hu";
    var buttonText = currentCulture == "hu" ? "🇬🇧 EN" : "🇭🇺 HU";
    }
    <div class="flex justify-between items-center mb-6 relative z-50">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
        <div class="glass rounded-full px-4 py-2 text-sm font-bold text-slate-300 flex items-center gap-3">
            <span class="truncate max-w-[120px] sm:max-w-[200px]">👤 @User.Identity.Name</span>

            <div class="w-px h-4 bg-slate-600"></div>


            <a asp-controller="Account" asp-action="Logout" title="@Localizer["Kijelentkezés"]" class="text-slate-400 hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>


            <form asp-controller="Account" asp-action="DeleteAccount" method="post" class="inline flex items-center">
                <button type="submit" title="@Localizer["Fiók Törlése"]" onclick="return confirm('@Localizer["Biztosan törlöd a teljes fiókodat? Ez nem vonható vissza!"]');" class="text-rose-500 hover:text-rose-400 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
            </form>
        </div>
        }
        else
        {
        <div class="flex gap-2">
            <a asp-controller="Account" asp-action="Login" class="glass rounded-full px-3 py-2 text-xs font-bold text-slate-300 hover:text-white transition-colors flex items-center">
                @Localizer["Bejelentkezés"]
            </a>
            <a asp-controller="Account" asp-action="Register" class="glass rounded-full px-3 py-2 text-xs font-bold text-cyan-400 hover:text-cyan-300 transition-colors border border-cyan-500/30 flex items-center">
                @Localizer["Regisztráció"]
            </a>
        </div>
        }
        <form asp-controller="Tracker" asp-action="SetLanguage" method="post" class="shrink-0 ml-2">
            <input type="hidden" name="culture" value="@targetCulture" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button type="submit" class="glass rounded-full px-3 py-2 text-sm font-bold text-slate-300 hover:text-white hover:bg-slate-700/50 transition-all shadow-lg border border-slate-600/50 flex items-center">
                @buttonText
            </button>
        </form>
    </div>

    @RenderBody()
</main>


<div id="cookie-banner" class="fixed bottom-0 left-0 w-full glass p-4 text-center z-[100] hidden flex-col sm:flex-row items-center justify-center gap-4">
    <p class="text-sm text-slate-300">
        @Localizer["Ez az oldal sütiket (cookie-kat) használ a beállításaid és a fiókod mentéséhez."]
    </p>
    <button onclick="acceptCookies()" class="bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-bold px-5 py-2 rounded-xl text-sm transition-colors whitespace-nowrap active:scale-95">
        @Localizer["Rendben, Értem"]
    </button>
</div>

<script>
    if (!document.cookie.includes("CookieConsent=true")) {
        document.getElementById("cookie-banner").classList.remove("hidden");
        document.getElementById("cookie-banner").classList.add("flex");
    }
    function acceptCookies() {
        document.cookie = "CookieConsent=true; max-age=31536000; path=/";
        document.getElementById("cookie-banner").classList.add("hidden");
        document.getElementById("cookie-banner").classList.remove("flex");
    }

    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js');
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>