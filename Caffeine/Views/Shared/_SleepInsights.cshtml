@model IEnumerable<Caffeine.Services.SleepInsight>
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T
<section class="glass panel">
    <div class="page-heading"><h2>@T["SleepInsights"]</h2><partial name="_InfoButton" model='@("SleepInsightHelp")' /></div>
    <p class="insight-caution">@T["SleepInsightNote"]</p>
    @foreach (var item in Model) {
        <article class="insight-card">
            <h3>@T[item.MetricKey]</h3>
            <p class="insight-stage">@T[item.StageKey]</p>
            <p class="muted text-sm">@T["SleepSample", item.Count]</p>
            <p class="text-sm mt-2">@T[item.ObservationKey]</p>
            <details class="insight-details"><summary>@T["HowCalculated"]</summary>
                <p>@T["SleepInsightMethod"]</p>
                @if (item.HasRelationshipData) { <p>r = @item.Correlation.ToString("0.00", System.Globalization.CultureInfo.CurrentCulture)</p> }
                <p>@T["SleepInsightNote"]</p>
            </details>
        </article>
    }
</section>
