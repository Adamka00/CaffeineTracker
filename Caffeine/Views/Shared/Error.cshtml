@model ErrorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Caffeine.SharedResource> T
@{ Layout = "_RecoveryLayout"; ViewData["Title"] = T["ErrorTitle"]; }
<h1>@T["ErrorTitle"]</h1><p>@T["ErrorText"]</p>
@if (Model.ShowRequestId) { <p>@T["RequestId"] <code>@Model.RequestId</code></p> }
<a href="/">@T["Daily"]</a>
