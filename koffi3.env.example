# EXAMPLE ONLY. Do not commit real credentials. Docker env_file uses literal values.
# Existing settings: keep production DB/key paths and the current timezone.
ConnectionStrings__DefaultConnection=Data Source=/data/caffeine.db
DataProtection__KeyPath=/data/keys
Tracker__TimeZone=Europe/Budapest

# Password recovery: HTTPS origin without a path. Enable only after SMTP is configured.
Account__PublicOrigin=https://koffi.hu
Email__Enabled=false
Email__Host=YOUR_SMTP_HOST
Email__Port=587
Email__From=noreply@koffi.hu
Email__Username=YOUR_SMTP_USERNAME
Email__Password=REPLACE_LOCALLY_DO_NOT_COMMIT

# Web Push: stable keypair generated locally using tools/GenerateVapidKeys.cs.
Push__Enabled=false
Push__Subject=mailto:noreply@koffi.hu
Push__PublicKey=REPLACE_WITH_GENERATED_PUBLIC_KEY
Push__PrivateKey=REPLACE_LOCALLY_DO_NOT_COMMIT

# Only set the actual trusted Caddy/reverse-proxy IP(s), never arbitrary clients.
# ReverseProxy__KnownProxies__0=YOUR_ACTUAL_PROXY_IP